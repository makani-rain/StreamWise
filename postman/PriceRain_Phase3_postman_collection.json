		{
			"name": "Get admin_access_token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse JSON, save tokens to workspace variables, and add assertions",
							"pm.test(\"Status code is 200\", function () {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"let isJson = true;",
							"let data = null;",
							"",
							"pm.test(\"Response is valid JSON\", function () {",
							"  try {",
							"    data = pm.response.json();",
							"    pm.expect(typeof data).to.equal(\"object\");",
							"  } catch (e) {",
							"    isJson = false;",
							"  }",
							"  pm.expect(isJson, \"Response body is not valid JSON\").to.be.true;",
							"});",
							"",
							"if (isJson && data) {",
							"  // Extract values",
							"  const accessToken = data.access_token;",
							"  const refreshToken = data.refresh_token;",
							"  const tokenType = data.token_type;",
							"  const expiresIn = data.expires_in;",
							"",
							"  // Save to workspace (environment) variables",
							"  if (typeof accessToken !== 'undefined') pm.collectionVariables.set(\"access_token_admin\", accessToken);",
							"  if (typeof refreshToken !== 'undefined') pm.collectionVariables.set(\"refresh_token_admin\", refreshToken);",
							"  if (typeof tokenType !== 'undefined') pm.collectionVariables.set(\"token_type_admin\", tokenType);",
							"  if (typeof expiresIn !== 'undefined') pm.collectionVariables.set(\"access_token_expires_in_admin\", String(expiresIn));",
							"",
							"  // Assert access_token exists and is non-empty",
							"  pm.test(\"access_token is present and non-empty\", function () {",
							"    pm.expect(accessToken, \"access_token missing\").to.exist;",
							"    pm.expect(String(accessToken).length, \"access_token is empty\").to.be.greaterThan(0);",
							"  });",
							"} else {",
							"  // If JSON parsing failed, still surface a clear failing test for token presence",
							"  pm.test(\"access_token is present and non-empty\", function () {",
							"    pm.expect(false, \"Cannot validate access_token because response is not JSON\").to.be.true;",
							"  });",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
