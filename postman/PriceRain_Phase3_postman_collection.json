		{
			"name": "RateLimiter Test w/Script - Consumer:Titles",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Circuit Breaker Trigger Script",
							"// This script will rapidly send the same request multiple times to trigger the backend circuit breaker.",
							"// Adjust 'repeatCount' as needed to match your backend's circuit breaker threshold.",
							"",
							"const repeatCount = 50; // Number of times to send the request rapidly",
							"const delayMs = 1; // Delay between requests in milliseconds (reduce for more rapid calls)",
							"",
							"const requestOptions = {",
							"    url: pm.request.url.toString(),",
							"    method: pm.request.method,",
							"    header: pm.request.headers.toObject(),",
							"    body: pm.request.body ? pm.request.body.toString() : undefined",
							"};",
							"",
							"let responses = [];",
							"",
							"function sendRepeatedRequests(count) {",
							"    if (count === 0) {",
							"        // All requests sent, visualize results",
							"        pm.visualizer.set(",
							"            `<style>",
							"  .results { border-collapse: collapse; }",
							"  .results, .results th, .results td {",
							"    background: #ccc;",
							"    color: #000;",
							"    border: 1px solid #000;",
							"  }",
							"  .results th, .results td { padding: 4px; }",
							"</style>",
							"",
							"<table class=\"results\">",
							"  <tr><th>Attempt</th><th>Status</th><th>Response Time (ms)</th><th>titleName</th></tr>",
							"  {{#each responses}}",
							"  <tr>",
							"    <td>{{@index}}</td>",
							"    <td>{{this.code}}</td>",
							"    <td>{{this.responseTime}}</td>",
							"    <td>{{this.titleName}}</td>",
							"  </tr>",
							"  {{/each}}",
							"</table>`,",
							"            { responses }",
							"        );",
							"        return;",
							"    }",
							"    pm.sendRequest(requestOptions, function (err, res) {",
							"        responses.push({",
							"            code: res ? res.code : (err ? err.message : 'Unknown'),",
							"            responseTime: res ? res.responseTime : null,",
							"            titleName: res ? res.json()[0]?.titleName : null",
							"        });",
							"        setTimeout(function () {",
							"            sendRepeatedRequests(count - 1);",
							"        }, delayMs);",
							"    });",
							"}",
							"",
							"// Only run this script if it's the first test iteration",
							"if (pm.info.iteration === 0) {",
							"    sendRepeatedRequests(repeatCount);",
							"} else {",
							"    pm.test('Circuit breaker test skipped on non-initial iteration', function () {",
							"        pm.expect(true).to.be.true;",
							"    });",
							"}",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
